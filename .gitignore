# macOS
.DS_Store

# Xcode
DerivedData/
xcuserdata/
*.xcuserstate
*.xcresult
*.xcarchive

# Swift Package Manager (KyosakuCore)
.build/
.swiftpm/

# SourceKit-LSP (machine-specific, generated by xcode-build-server)
buildServer.json
.compile

# Build output
build/
dist/

# Code coverage
*.profdata
*.xccovarchive
*.xccovreport

# Local signing configuration (holds your own development team ID)
Configs/Signing.local.xcconfig

# Signing material that must never be committed
*.p12
*.provisionprofile

# Temporary files
*.swp
*.tmp
*.orig

# Claude Code: personal files that the official documentation says to keep out of the repository
# https://code.claude.com/docs/en/claude-directory
**/.claude/settings.local.json
CLAUDE.local.md
.claude/agent-memory-local/
.claude/worktrees/

# superpowers: planning documents are never committed, and its scratch data stays local
docs/superpowers/
.superpowers/
.worktrees/
